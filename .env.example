# Required for live SEC access: replace with your own name and real email.
SEC_USER_AGENT=
# Optional, server-side only. Core monitoring does not need this.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
REFRESH_SECONDS=3600
# Local development only (Compose supplies its internal database URL).
DATABASE_URL=postgresql+psycopg://thesis:thesis@localhost:5432/thesis
# Neon writes private connections to .env.local, which overrides .env.
# Use its direct connection for migrations; normal app traffic uses pooled DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Email alerts require all three. Use a Resend verified sender.
ALERT_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
# Hosted deployment: HTTPS public origin and a strong owner password.
# Browser sign-in username is owner. Do not use a free/sleeping host for workers.
APP_ORIGIN=
OWNER_PASSWORD=
# Shared earnings calendar for every watched ticker. No local date guessing.
ALPHAVANTAGE_API_KEY=
CALENDAR_REFRESH_HOURS=24
FINANCIAL_REFRESH_HOURS=24
# Fallback when the earnings provider has no date for a stock.
UNKNOWN_EARNINGS_REFRESH_HOURS=168
EARNINGS_LEAD_DAYS=0
EARNINGS_FOLLOWUP_DAYS=30
